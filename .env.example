# --- Global Settings ---
COMPOSE_PROJECT_NAME=iot_manager

# --- PostgreSQL for Auth Service ---
POSTGRES_AUTH_HOST_PORT=5433
POSTGRES_AUTH_USER=auth_user
POSTGRES_AUTH_PASSWORD=strongpassword1
POSTGRES_AUTH_DB=iot_auth_db
POSTGRES_AUTH_DOCKER_HOST=postgres-auth
AUTH_DATABASE_URL=postgresql://${POSTGRES_AUTH_USER}:${POSTGRES_AUTH_PASSWORD}@postgres-auth:5432/${POSTGRES_AUTH_DB}?schema=public
POSTGRES_AUTH_DOCKER_PORT=5432

# --- PostgreSQL for Device Management Service ---
# POSTGRES_DEVICE_HOST_PORT=5434
# POSTGRES_DEVICE_USER=device_user
# POSTGRES_DEVICE_PASSWORD=strongpassword2
# POSTGRES_DEVICE_DB=iot_device_db
# DEVICE_DATABASE_URL=postgresql://${POSTGRES_DEVICE_USER}:${POSTGRES_DEVICE_PASSWORD}@postgres-device:5432/${POSTGRES_DEVICE_DB}?schema=public

# --- Redis for Caching ---
REDIS_HOST_PORT=6379
REDIS_HOST=redis-cache

# --- RabbitMQ Broker ---
RABBITMQ_HOST_PORT=5672
RABBITMQ_USER=fi...
RABBITMQ_PASSWORD=20qweqrwer...
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_HOST=rmq.bla-bla-bla.com
RABBITMQ_EVENTS_QUEUE=iot_events_queue
RABBITMQ_STREAM_QUEUE=gateway_stream_queue
RABBITMQ_TELEMETRY_QUEUE=iot_telemetry_queue
RABBITMQ_VHOST=fi...

# --- InfluxDB for Statistics Service ---
INFLUXDB_HOST_PORT=8086
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=my_secure_password_123
INFLUXDB_ORG=iot_home
INFLUXDB_BUCKET=telemetry
INFLUXDB_ADMIN_TOKEN=my-super-secret-token-for-diploma
INFLUXDB_URL=http://influxdb:8086

# --- Auth Service Config ---
AUTH_SERVICE_HOST_PORT=50051
AUTH_SERVICE_CONTAINER_PORT=50051
AUTH_SERVICE_GRPC_URL=auth-service:${AUTH_SERVICE_HOST_PORT}

AUTH_SERVICE_DB_HOST="auth-service-db-host"
AUTH_SERVICE_DB_PORT=5432
AUTH_SERVICE_DB_USER="admin"
AUTH_SERVICE_DB_PASSWORD="supersecret password for db"
AUTH_SERVICE_DB_NAME="auth-service"
AUTH_SERVICE_DB_SSL=false

AUTH_SERVICE_JWT_SECRET="super_secret"

AUTH_SERVICE_GOOGLE_CLIENT_ID=707300670328....
AUTH_SERVICE_GOOGLE_CLIENT_SECRET=GORWQX-7oQU...

# --- Device Management Service Config ---
DEVICE_SERVICE_HOST_PORT=50055
DEVICE_SERVICE_CONTAINER_PORT=50055
DEVICE_SERVICE_GRPC_URL=device-service:${DEVICE_SERVICE_HOST_PORT}

DEVICE_SERVICE_DB_HOST="device-service-db-host"
DEVICE_SERVICE_DB_PORT=5432
DEVICE_SERVICE_DB_USER="admin"
DEVICE_SERVICE_DB_PASSWORD="supersecret password for db"
DEVICE_SERVICE_DB_NAME="device-service"
DEVICE_SERVICE_DB_SSL=true

# --- Broker Service Config ---
BROKER_SERVICE_HOST_PORT=50060
BROKER_SERVICE_CONTAINER_PORT=50060

MQTT_BROKER_URL=mqtt://mosquitto-broker:1883
DEVICE_SERVICE_GRPC_URL=device-service:50055

BROKER_SERVICE_REDIS_URL="redis://default..."

# --- Api Gateway Config ---
API_GATEWAY_HOST_PORT=3000
API_GATEWAY_CONTAINER_PORT=3000
FRONTEND_URL=http://localhost:5173
